# URL de l'API Directus telle que vue depuis VOTRE navigateur.
#
# - Codespaces dans le navigateur (github.dev, ou l'onglet Ports du Codespace) :
#     utilisez l'URL forwardée complète du port 8055, ex.
#     https://<nom-du-codespace>-8055.app.github.dev
# - VS Code Desktop (réexpose les ports forwardés sur votre propre machine) :
#     http://localhost:8055 fonctionne aussi.
VITE_DIRECTUS_URL=http://localhost:8055

# Jeton statique de l'utilisateur applicatif "Agent Bureau d'Ordre"
# (Directus > Paramètres > Utilisateurs > [utilisateur] > Jeton statique)
# Convient pour le développement uniquement — en production, préférez un flux
# d'authentification utilisateur (login) plutôt qu'un jeton partagé.
VITE_DIRECTUS_TOKEN=
