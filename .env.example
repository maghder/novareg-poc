# Exemple uniquement.
# Pour GitHub Codespaces, utiliser Settings > Secrets and variables > Codespaces.
# Ne jamais mettre les vraies valeurs dans ce fichier.

DB_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
DIRECTUS_SECRET=CHANGE_ME_RANDOM_SECRET

# Pas de 5e secret pour la clé de chiffrement Directus (KEY) : elle est
# générée automatiquement au premier lancement de scripts/start-directus.sh
# et conservée localement dans directus/.directus-key (jamais committée).
